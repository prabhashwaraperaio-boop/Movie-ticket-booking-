# ============================================================================
# CINEMORA — Apache Security & Routing Configuration
# ============================================================================
Options -Indexes

# Protect sensitive files
<FilesMatch "^(\.gitignore|schema\.sql|database\.local\.php|database\.example\.php|setup\.lock|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
